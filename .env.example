# Copy this file to .env and fill in your values. Never commit the real file.

# Database the app uses. Locally: your own PostgreSQL.
# On Neon: the POOLED connection string (its host contains "-pooler").
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tiun?schema=public"

# Database used for migrations. Locally: the same as DATABASE_URL.
# On Neon: the DIRECT connection string (host without "-pooler").
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tiun?schema=public"

# Public address of the app, used in invite links and API examples.
# Leave empty locally; in production set e.g. https://tiun-dashboard.vercel.app
APP_URL=""

# Password given to every seeded team member (local development only).
SEED_PASSWORD="tiun-demo-2026"
